prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: niimblue
Description: NIIMBOT label printer library (niimbluelib + QuickJS) with a C API
Version: @PROJECT_VERSION@
Cflags: -I${includedir}@NIIM_PC_CFLAGS@
Libs: -L${libdir} -l@NIIM_PC_LIBNAME@
Libs.private: @NIIM_PC_PRIVATE_LIBS@
